<?xml version="1.0" encoding="UTF-8"?>
<!--
  Custom plugin repository, so PhpStorm offers updates without the JetBrains Marketplace.
  Users add this URL under Settings › Plugins › ⚙ › Manage Plugin Repositories…:
    https://raw.githubusercontent.com/Tygovanommen/editor-browser/main/updatePlugins.xml
  On release: bump version + url to the new GitHub release asset (tools/release.sh does this).
-->
<plugins>
  <plugin id="nl.netonic.editor-browser"
          url="https://github.com/Tygovanommen/editor-browser/releases/download/v0.2.2/editor-browser-0.2.2.zip"
          version="0.2.2">
    <idea-version since-build="262"/>
    <name>Editor Browser</name>
    <vendor url="https://netonic.nl">Netonic</vendor>
    <description>Websites as editor tabs, right next to your files, in PhpStorm's own embedded Chromium.</description>
  </plugin>
</plugins>
